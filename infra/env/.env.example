# Copy file này thành `.env` rồi điền giá trị thật: cp .env.example .env
# Không commit `.env` (đã có trong .gitignore).
#
# File này dùng cho docker-compose (docker-compose.yml và
# docker-compose.local.yml) ở thư mục gốc — chạy `pnpm dev` cho từng app riêng
# lẻ thì dùng apps/server/.env.example và apps/web/.env.example thay vì file
# này.

# ─────────────────────────── Compose ───────────────────────────
# Tag image kéo từ GHCR khi chạy docker-compose.yml (bản build sẵn).
IMAGE_TAG=latest
# Port publish ra host khi chạy docker-compose.local.yml (build tại chỗ).
SERVER_PORT=8000
WEB_PORT=3000

# ─────────────────────────── App ───────────────────────────
NODE_ENV=production
PORT=8000

# ─────────────────────────── Database ───────────────────────────
# [BẮT BUỘC] PostgreSQL. Prisma schema/client sống ở packages/db (chạy
# `prisma migrate`/`prisma studio` từ đó, xem packages/db/prisma.config.ts);
# apps/server chỉ import default export của @flood-bridge-alert/db.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flood-bridge-alert"

# ─────────────────────────── Auth (better-auth) ───────────────────────────
# [BẮT BUỘC] Secret dùng để ký session/token, tối thiểu 32 ký tự. Sinh bằng:
# `openssl rand -base64 32`, hoặc: scripts/generate-secrets.sh better-auth-secret
BETTER_AUTH_SECRET=

# [BẮT BUỘC] URL public của server (better-auth dùng làm base URL), phải là
# URL hợp lệ (zod z.url()).
BETTER_AUTH_URL=http://localhost:8000

# ─────────────────────────── CORS ───────────────────────────
# [BẮT BUỘC] Origin của web app được phép gọi CORS, phải là URL hợp lệ.
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────── Blynk webhook ───────────────────────────
# [BẮT BUỘC] Token dùng để xác thực webhook từ Blynk (xem
# apps/server/src/webhooks/blynk.ts).
BLYNK_WEBHOOK_TOKEN=
# Không phải biến của app — chỉ dùng bởi scripts/simulate-blynk.sh để giả
# lập request Blynk gửi tới server lúc dev/test thủ công.
BLYNK_WEBHOOK_URL=http://localhost:8000/webhooks/blynk

# ─────────────────────────── Web Push (VAPID) ───────────────────────────
# [BẮT BUỘC] Cặp khoá VAPID dùng để gửi push notification. Sinh bằng:
# `npx web-push generate-vapid-keys`, hoặc: scripts/generate-secrets.sh vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email hoặc URL liên hệ, dạng "mailto:you@example.com"
VAPID_SUBJECT=mailto:example@example.com

# ─────────────────────────── Superadmin seed ───────────────────────────
# Dùng bởi script `pnpm seed:admin` (apps/server/src/scripts/seed-admin.ts)
# để tạo tài khoản admin đầu tiên. Không bắt buộc, nhưng thiếu thì script seed
# sẽ báo lỗi.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Super Admin"

# ─────────────────────────── Web build (docker-compose.local.yml) ───────────
# [BẮT BUỘC] Truyền vào lúc build image web làm build arg — phải là URL công
# khai mà trình duyệt gọi tới được (khác VITE_SERVER_URL của apps/web khi
# chạy `pnpm dev`, thường trỏ localhost).
VITE_SERVER_URL=http://localhost:8000
# [BẮT BUỘC] Phải trùng với VAPID_PUBLIC_KEY ở trên.
VITE_VAPID_PUBLIC_KEY=
