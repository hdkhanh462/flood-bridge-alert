# Copy file này thành `.env` rồi điền giá trị thật: cp .env.example .env
# Không commit `.env` (đã có trong .gitignore).
#
# Schema env được validate ngay lúc build/dev (xem packages/env/src/web.ts,
# dùng createEnv/z từ @t3-oss/env-core, import từ @flood-bridge-alert/env/web)
# — thiếu hoặc sai biến bắt buộc sẽ crash app ngay khi khởi động, không đợi
# tới lúc runtime. Chỉ biến có prefix `VITE_` mới được Vite expose ra client.

# ─────────────────────────── Dev server (vite) ───────────────────────────
# Port của `vite dev` (xem vite.config.ts). Không có prefix `VITE_` vì chỉ
# vite.config.ts (chạy trên Node) đọc, không cần expose ra client.
PORT=3000

# ─────────────────────────── Server ───────────────────────────
# [BẮT BUỘC] URL của apps/server, phải là URL hợp lệ (zod z.url()).
VITE_SERVER_URL=http://localhost:8000

# ─────────────────────────── Web Push (VAPID) ───────────────────────────
# [BẮT BUỘC] Public key VAPID dùng để đăng ký push notification ở client,
# phải trùng với VAPID_PUBLIC_KEY của apps/server.
VITE_VAPID_PUBLIC_KEY=
