# Copy file này thành `.env` rồi điền giá trị thật: cp .env.example .env
# Không commit `.env` (đã có trong .gitignore).
#
# Schema env được validate ngay lúc boot (xem packages/env/src/server.ts, dùng
# createEnv/z từ @t3-oss/env-core, import từ @flood-bridge-alert/env/server) —
# thiếu hoặc sai biến bắt buộc sẽ crash app ngay khi khởi động, không đợi tới
# lúc runtime.

# ─────────────────────────── App ───────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────── Database ───────────────────────────
# [BẮT BUỘC] PostgreSQL. Prisma schema/client sống ở packages/db (chạy
# `prisma migrate`/`prisma studio` từ đó, xem packages/db/prisma.config.ts);
# apps/server chỉ import default export của @flood-bridge-alert/db.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flood-bridge-alert"

# ─────────────────────────── Auth (better-auth) ───────────────────────────
# [BẮT BUỘC] Secret dùng để ký session/token, tối thiểu 32 ký tự. Sinh bằng:
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# [BẮT BUỘC] URL public của server (better-auth dùng làm base URL), phải là
# URL hợp lệ (zod z.url()).
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────── CORS ───────────────────────────
# [BẮT BUỘC] Origin của web app được phép gọi CORS, phải là URL hợp lệ.
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────── Blynk webhook ───────────────────────────
# [BẮT BUỘC] Token dùng để xác thực webhook từ Blynk (xem
# src/webhooks/blynk.ts). Test thử bằng scripts/simulate-blynk.sh.
BLYNK_WEBHOOK_TOKEN=

# ─────────────────────────── Web Push (VAPID) ───────────────────────────
# [BẮT BUỘC] Cặp khoá VAPID dùng để gửi push notification. Sinh bằng:
# `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email hoặc URL liên hệ, dạng "mailto:you@example.com"
VAPID_SUBJECT=mailto:example@example.com

# ─────────────────────────── Superadmin seed ───────────────────────────
# Dùng bởi script `pnpm seed:admin` (src/scripts/seed-admin.ts) để tạo tài
# khoản admin đầu tiên. Không bắt buộc, nhưng thiếu thì script seed sẽ báo lỗi.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Super Admin"
