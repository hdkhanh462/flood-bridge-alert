enum BridgeStatus {
  SAFE
  WARNING
  DANGER
}

model Bridge {
  id        String   @id @default(cuid())
  name      String
  location  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threshold         Threshold?
  readings          WaterLevelReading[]
  alerts            AlertHistory[]
  pushSubscriptions PushSubscription[]
  mutes             PushSubscriptionMute[]

  @@map("bridge")
}

model Threshold {
  id         String   @id @default(cuid())
  bridgeId   String   @unique
  bridge     Bridge   @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  safeMax    Float
  warningMax Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("threshold")
}

model WaterLevelReading {
  id         String       @id @default(cuid())
  bridgeId   String
  bridge     Bridge       @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  level      Float
  status     BridgeStatus @default(SAFE)
  recordedAt DateTime     @default(now())

  @@index([bridgeId, recordedAt])
  @@map("water_level_reading")
}

model AlertHistory {
  id        String       @id @default(cuid())
  bridgeId  String
  bridge    Bridge       @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  status    BridgeStatus
  createdAt DateTime     @default(now())

  @@index([bridgeId, createdAt])
  @@map("alert_history")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  bridges   Bridge[]
  mutes     PushSubscriptionMute[]

  @@index([userId])
  @@map("push_subscription")
}

// Tạm tắt cảnh báo push cho 1 cầu cụ thể trong 1 khoảng thời gian, tránh
// spam khi mực nước dao động quanh ngưỡng. Độc lập với danh sách "bridges"
// (cầu đang theo dõi) — có thể mute 1 cầu ngay cả khi đang theo dõi tất cả.
model PushSubscriptionMute {
  id                 String           @id @default(cuid())
  pushSubscriptionId String
  pushSubscription   PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)
  bridgeId           String
  bridge             Bridge           @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  mutedUntil         DateTime

  @@unique([pushSubscriptionId, bridgeId])
  @@map("push_subscription_mute")
}
